<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches StrideColors.ink: the launcher never has a light theme, so the splash -->
    <!-- should not either, regardless of the system's day/night setting. This device is -->
    <!-- API 28, so it resolves this file rather than the base drawable/ one - the theme- -->
    <!-- relative ?android:colorBackground it used to point at resolved to white here. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF05070A" />
        </shape>
    </item>

    <!-- You can insert your own image assets here -->
    <!-- <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item> -->
</layer-list>
